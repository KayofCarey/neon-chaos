<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NEON CHAOS</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  background: #080817;
  color: white;
  font-family: Arial, sans-serif;
  text-align: center;
}
h1 {
  color: #ff36db;
  font-size: 42px;
  text-shadow: 0 0 20px #ff36db;
}
#game {
  display: block;
  margin: 15px auto;
  width: min(94vw, 500px);
  height: auto;
  background: linear-gradient(#11112e,#21103c);
  border: 3px solid #a855f7;
  border-radius: 15px;
}
button {
  background: #ff36db;
  border: none;
  border-radius: 12px;
  padding: 14px 25px;
  color: white;
  font-size: 18px;
  font-weight: bold;
  cursor: pointer;
  margin: 8px;
}
button:hover { background: #a855f7; }
#info { font-size: 18px; }
</style>
</head>
<body>

<h1>🌈 NEON CHAOS</h1>
<p id="info">Score: 0 | ❤️ Lives: 3</p>
<canvas id="game" width="500" height="600"></canvas>
<button onclick="startGame()">START GAME</button>
<p>Use ← → or A / D to move. Collect coins and dodge blocks!</p>

<script>
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

let player, obstacles, coins, score, lives;
let playing = false;
let frame = 0;
let keys = {};

function reset() {
  player = { x: 230, y: 520, w: 40, h: 40, speed: 6 };
  obstacles = [];
  coins = [];
  score = 0;
  lives = 3;
  frame = 0;
}

function startGame() {
  reset();
  playing = true;
  requestAnimationFrame(loop);
}

document.addEventListener("keydown", e => {
  keys[e.key.toLowerCase()] = true;
});
document.addEventListener("keyup", e => {
  keys[e.key.toLowerCase()] = false;
});

function rectangle(x,y,w,h,color) {
  ctx.shadowBlur = 15;
  ctx.shadowColor = color;
  ctx.fillStyle = color;
  ctx.fillRect(x,y,w,h);
  ctx.shadowBlur = 0;
}

function spawn() {
  if (frame % 45 === 0) {
    obstacles.push({
      x: Math.random()*450,
      y: -40,
      size: 30 + Math.random()*25,
      speed: 3 + Math.min(score/100, 5)
    });
  }

  if (frame % 90 === 0) {
    coins.push({
      x: 20 + Math.random()*450,
      y: -20,
      size: 15,
      speed: 4
    });
  }
}

function loop() {
  if (!playing) return;

  frame++;
  ctx.clearRect(0,0,500,600);

  // Background stars
  for (let i=0;i<35;i++) {
    ctx.fillStyle = "#ffffff";
    ctx.globalAlpha = 0.2 + Math.random()*0.5;
    ctx.fillRect((i*83)%500,(i*137+frame*2)%600,2,2);
  }
  ctx.globalAlpha = 1;

  // Movement
  if (keys["arrowleft"] || keys["a"]) player.x -= player.speed;
  if (keys["arrowright"] || keys["d"]) player.x += player.speed;
  player.x = Math.max(0,Math.min(460,player.x));

  // Player
  rectangle(player.x,player.y,player.w,player.h,"#00f5ff");
  ctx.fillStyle = "white";
  ctx.font = "25px Arial";
  ctx.fillText("★",player.x+7,player.y+29);

  spawn();

  // Obstacles
  obstacles.forEach((o,i) => {
    o.y += o.speed;
    rectangle(o.x,o.y,o.size,o.size,"#ff3366");

    if (player.x < o.x+o.size &&
        player.x+player.w > o.x &&
        player.y < o.y+o.size &&
        player.y+player.h > o.y) {
      obstacles.splice(i,1);
      lives--;
      if (lives <= 0) endGame();
    }
  });

  // Coins
  coins.forEach((c,i) => {
    c.y += c.speed;
    ctx.shadowBlur = 20;
    ctx.shadowColor = "gold";
    ctx.fillStyle = "gold";
    ctx.beginPath();
    ctx.arc(c.x,c.y,c.size,0,Math.PI*2);
    ctx.fill();
    ctx.shadowBlur = 0;

    if (Math.hypot(
      player.x+20-c.x,
      player.y+20-c.y
    ) < 30) {
      coins.splice(i,1);
      score += 10;
    }
  });

  obstacles = obstacles.filter(o => o.y < 650);
  coins = coins.filter(c => c.y < 650);

  score++;
  document.getElementById("info").innerText =
    `Score: ${score} | ❤️ Lives: ${lives}`;

  if (playing) requestAnimationFrame(loop);
}

function endGame() {
  playing = false;
  ctx.fillStyle = "rgba(0,0,0,0.8)";
  ctx.fillRect(0,0,500,600);
  ctx.fillStyle = "#ff36db";
  ctx.textAlign = "center";
  ctx.font = "bold 42px Arial";
  ctx.fillText("GAME OVER!",250,270);
  ctx.fillStyle = "white";
  ctx.font = "25px Arial";
  ctx.fillText("Score: "+score,250,320);
  ctx.font = "18px Arial";
  ctx.fillText("Press START to try again!",250,370);
  ctx.textAlign = "left";
}

reset();
ctx.fillStyle = "white";
ctx.font = "24px Arial";
ctx.fillText("Press START to play!",125,300);
</script>
</body>
</html>
